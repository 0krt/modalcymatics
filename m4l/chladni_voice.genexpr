// CHLADNI // MODAL — one voice: a modal resonator bank excited by a mallet and a drive waveform.
// runs once per mc channel inside mc.gen~ @chans 8. the tables are written by the v8ui.

Param ev(0);            // packed note event: counter*65536 + pitch*256 + velocity
Param glide(0, min=0);
Param mapmode(0);       // 0 chromatic, 1 resonance ladder
Param platetune(36);    // plate fundamental (midi note); in ladder mode this note is rung 1
Param keytrack(100);    // % the plate follows the played note (chromatic mode)
Param q(300, min=1);
Param damp(50);         // % of Q taken away on note-off
Param strike(80);
Param hardness(50);
Param drive(0);
Param dattack(20, min=1);
Param drelease(300, min=1);
Param nmodes(0);
Param nladder(0);
Param npart(1);

Buffer mratio("mratio");
Buffer mgain("mgain");
Buffer ladder("ladder");
Buffer partials("partials");

Data ys(64, 2);         // resonator state y[n-1], y[n-2]
Data cf(64, 4);         // c1, c2, strike gain, drive gain
Data gs(64);            // smoothed mode level

History lastev(0);
History tgt(60);
History pch(60);
History gate(0);
History vel(0);
History tp(1000000);
History env(0);
History ph(0);
History cnt(0);

dummy = in1;

// ---- note events ----
if (ev != lastev) {
	lastev = ev;
	vv = ev % 256;
	pp = floor(ev / 256) % 256;
	if (vv > 0) {
		if (gate < 0.5) pch = pp;              // glide only between held notes
		tgt = pp;
		vel = vv / 127;
		gate = 1;
		tp = 0;
	} else if (pp == tgt) {
		gate = 0;
	}
}

gk = 1;
if (glide > 0) gk = 1 - exp(-1 / (glide * 0.001 * samplerate));
pch = pch + (tgt - pch) * gk;

// ---- plate fundamental f0 and drive frequency fd ----
f0 = 0;
fd = 0;
if (mapmode < 0.5) {
	f0 = mtof(platetune + (pch - platetune) * keytrack / 100);
	fd = mtof(pch);
} else {
	f0 = mtof(platetune);
	fd = f0;
	if (nladder >= 1) {
		rung = clamp(pch - platetune, 0, nladder - 1);
		ri = floor(rung);
		fr = rung - ri;
		ra = peek(ladder, ri);
		rb = peek(ladder, min(ri + 1, nladder - 1));
		fd = f0 * (ra + (rb - ra) * fr);
	}
}

// ---- mallet: a half-sine pulse of unit area, shorter = harder = brighter ----
// contact time is a fraction of the plate's period, so hardness reads the same on every key
plen = max(2, 0.5 * pow(0.02, hardness / 100) / f0 * samplerate);
sx = 0;
if (tp < plen) {
	sx = sin(pi * tp / plen) * (pi / (2 * plen)) * vel * strike / 100;
	tp = tp + 1;
}

// ---- drive: additive harmonic waveform under an attack / release envelope ----
ph = wrap(ph + fd / samplerate, 0, 1);
osc = 0;
np = min(npart, 8);
for (n = 1; n <= np; n = n + 1) {
	if (n * fd < samplerate * 0.45) osc = osc + peek(partials, n - 1) * sin(twopi * n * ph);
}
et = gate * vel;
etau = dattack;
if (et < env) etau = drelease;
env = env + (et - env) * (1 - exp(-1 / (etau * 0.001 * samplerate)));
dx = osc * env * drive / 100;

// ---- modal resonators ----
qe = q;
if (gate < 0.5) qe = q * (1 - 0.98 * damp / 100);
upd = cnt == 0;
cnt = (cnt + 1) % 32;

out = 0;
nm = min(nmodes, 64);
for (i = 0; i < nm; i = i + 1) {
	if (upd) {
		w = twopi * f0 * peek(mratio, i) / samplerate;
		if (w > 0.00001 && w < pi * 0.9) {
			r = exp(-w / (2 * qe));
			c1 = 2 * r * cos(w);
			c2 = r * r;
			dc = 1 - c1 + c2;                      // unity gain at dc
			poke(cf, c1, i, 0);
			poke(cf, c2, i, 1);
			poke(cf, dc / w, i, 2);                // struck: flat ring-up across the modes
			poke(cf, dc / qe, i, 3);               // driven: unity gain on resonance
		} else {
			poke(cf, 0, i, 0);
			poke(cf, 0, i, 1);
			poke(cf, 0, i, 2);
			poke(cf, 0, i, 3);
		}
	}
	a1 = peek(cf, i, 0);
	a2 = peek(cf, i, 1);
	g = peek(gs, i);
	g = g + (peek(mgain, i) - g) * 0.002;
	poke(gs, g, i);
	if (a2 > 0) {
		y1 = peek(ys, i, 0);
		y2 = peek(ys, i, 1);
		y = a1 * y1 - a2 * y2 + peek(cf, i, 2) * sx + peek(cf, i, 3) * dx;
		if (abs(y) < 1e-20) y = 0;
		poke(ys, y1, i, 1);
		poke(ys, y, i, 0);
		out = out + g * y;
	} else {
		poke(ys, 0, i, 0);
		poke(ys, 0, i, 1);
	}
}

out1 = tanh(out * 0.5);
